#!/bin/sh
# Wrapper for /usr/bin/adb placed in ~/.local/bin/adb
# 1. Unsets Steam Runtime's LD_LIBRARY_PATH so /usr/bin/adb does not fail with
#    libstdc++.so.6 GLIBCXX version mismatches when spawned by ALVR / SteamVR.
# 2. Rewrites dumpsys activity output when PhoneVR is resumed so InitActivity
#    (mResumed=false) does not mask ALVRActivity (mResumed=true).
unset LD_LIBRARY_PATH
case "$*" in
  *dumpsys*activity*)
    out=$(/usr/bin/adb "$@")
    if echo "$out" | grep -q "mResumed=true"; then
      echo "$out" | sed 's/mResumed=false/mResumed=true/g'
    else
      echo "$out"
    fi
    ;;
  *)
    exec /usr/bin/adb "$@"
    ;;
esac
